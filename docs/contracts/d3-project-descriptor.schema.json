{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/planning/d3-project-descriptor.schema.json",
  "title": "D3 planned project descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "revision", "frame_rate", "frame_count", "shots", "preview", "run_file", "studio_origin"],
  "properties": {
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "revision": { "type": "integer", "minimum": 0 },
    "frame_rate": { "type": "number", "exclusiveMinimum": 0 },
    "frame_count": { "type": "integer", "minimum": 1 },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "authoring_id", "start_frame", "end_frame_exclusive"],
        "properties": {
          "shot_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "authoring_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "end_frame_exclusive": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": { "const": "hypit-studio" },
        "url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/$" }
      }
    },
    "run_file": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+\\.svrun$" },
    "studio_origin": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$" }
  }
}
