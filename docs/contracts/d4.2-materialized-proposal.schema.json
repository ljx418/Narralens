{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/review/d4.2-materialized-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "materialization_id", "project_id", "comparison_id", "proposal_id", "base_revision", "selection", "proposal_sha256", "publication_manifest_sha256", "composite_asset_id", "composite_sha256", "recipe_sha256", "segments", "preserve", "renderable", "external_transfer", "materialization_cost", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "narralens.materialized_proposal" },
    "materialization_id": { "type": "string", "pattern": "^materialization_[a-z0-9_]+$" },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "comparison_id": { "type": "string", "pattern": "^comparison_[a-z0-9_]+$" },
    "proposal_id": { "type": "string", "pattern": "^proposal_[a-z0-9_]+$" },
    "base_revision": { "type": "integer", "minimum": 0 },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "start_frame", "end_frame_exclusive"],
      "properties": {
        "shot_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "start_frame": { "type": "integer", "minimum": 0 },
        "end_frame_exclusive": { "type": "integer", "minimum": 1 }
      }
    },
    "proposal_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "publication_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "composite_asset_id": { "type": "string", "pattern": "^asset_[a-z0-9][a-z0-9_-]{0,63}$" },
    "composite_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recipe_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "role", "duration_frames", "output_start_frame", "output_end_frame_exclusive", "asset_id", "asset_sha256", "source", "license"],
        "properties": {
          "segment_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
          "role": { "enum": ["anchor", "context", "contrast", "evidence", "transition", "conclusion"] },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "output_start_frame": { "type": "integer", "minimum": 0 },
          "output_end_frame_exclusive": { "type": "integer", "minimum": 1 },
          "asset_id": { "type": "string", "pattern": "^asset_[a-z0-9][a-z0-9_-]{0,63}$" },
          "asset_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source": {
            "type": "object", "additionalProperties": false, "required": ["kind", "label"],
            "properties": { "kind": { "enum": ["owned", "generated", "licensed"] }, "label": { "type": "string", "minLength": 1, "maxLength": 2048 }, "uri": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https?://" } }
          },
          "license": {
            "type": "object", "additionalProperties": false, "required": ["status", "label", "commercial_use"],
            "properties": { "status": { "const": "cleared" }, "label": { "type": "string", "minLength": 1, "maxLength": 2048 }, "commercial_use": { "const": true } }
          }
        }
      }
    },
    "preserve": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "allOf": [{ "contains": { "const": "narration" } }, { "contains": { "const": "duration" } }],
      "items": { "enum": ["narration", "duration"] }
    },
    "renderable": { "const": true },
    "external_transfer": { "const": false },
    "materialization_cost": {
      "type": "object", "additionalProperties": false, "required": ["status", "currency", "amount"],
      "properties": { "status": { "const": "not_applicable" }, "currency": { "type": "null" }, "amount": { "type": "null" } }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
