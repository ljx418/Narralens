{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/review/d4.2-materialize-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["comparison_id", "base_revision", "idempotency_key", "segment_bindings"],
  "properties": {
    "comparison_id": { "type": "string", "pattern": "^comparison_[a-z0-9_]+$" },
    "base_revision": { "type": "integer", "minimum": 0 },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "segment_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "asset_id"],
        "properties": {
          "segment_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
          "asset_id": { "type": "string", "pattern": "^asset_[a-z0-9][a-z0-9_-]{0,63}$" }
        }
      }
    }
  }
}
