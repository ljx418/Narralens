{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/review/d4.1-proposal-comparison.schema.json",
  "title": "Narralens D4.1 Stored Proposal Comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "comparison_id", "project_id", "base_revision", "selection", "intent_sha256", "preserve", "proposal_count", "proposals", "generation_audit", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "narralens.proposal_comparison" },
    "comparison_id": { "type": "string", "pattern": "^comparison_[A-Za-z0-9_-]+$" },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "base_revision": { "type": "integer", "minimum": 0 },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "start_frame", "end_frame_exclusive"],
      "properties": {
        "shot_id": { "type": "string", "pattern": "^shot-[A-Za-z0-9_-]+$" },
        "start_frame": { "type": "integer", "minimum": 0 },
        "end_frame_exclusive": { "type": "integer", "minimum": 1 }
      }
    },
    "intent_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preserve": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["narration", "duration"] }
    },
    "proposal_count": { "type": "integer", "minimum": 3, "maximum": 6 },
    "proposals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/proposal" }
    },
    "generation_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout_sha256", "model_names", "total_cost_usd", "duration_ms", "num_turns", "service_tier"],
      "properties": {
        "stdout_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "model_names": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "total_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "num_turns": { "type": ["integer", "null"], "minimum": 0 },
        "service_tier": { "type": ["string", "null"], "maxLength": 100 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "title", "strategy", "summary", "segments", "assets_needed", "source_refs", "materialization_cost", "requires_materialization", "renderable"],
      "properties": {
        "proposal_id": { "type": "string", "pattern": "^proposal_[A-Za-z0-9_-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rationale"],
          "properties": {
            "kind": { "enum": ["chronology", "contrast", "evidence-led", "map-led", "quote-led", "metaphor-led"] },
            "rationale": { "type": "string", "minLength": 1, "maxLength": 400 }
          }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segment_id", "duration_frames", "role", "intent", "asset_requirement_ids"],
            "properties": {
              "segment_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
              "duration_frames": { "type": "integer", "minimum": 1 },
              "role": { "enum": ["anchor", "context", "evidence", "contrast", "transition", "conclusion"] },
              "intent": { "type": "string", "minLength": 1, "maxLength": 500 },
              "asset_requirement_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" } }
            }
          }
        },
        "assets_needed": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement_id", "kind", "description", "duration_frames", "rights_requirement"],
            "properties": {
              "requirement_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
              "kind": { "enum": ["video", "image", "graphic", "map", "data-visualization"] },
              "description": { "type": "string", "minLength": 1, "maxLength": 500 },
              "duration_frames": { "type": "integer", "minimum": 1 },
              "rights_requirement": { "const": "cleared" }
            }
          }
        },
        "source_refs": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref_id", "kind", "label"],
            "properties": {
              "ref_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
              "kind": { "enum": ["project", "user-provided", "research"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 200 },
              "claim": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        },
        "materialization_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "currency", "amount"],
          "properties": {
            "status": { "const": "unknown" },
            "currency": { "type": "null" },
            "amount": { "type": "null" }
          }
        },
        "requires_materialization": { "const": true },
        "renderable": { "const": false }
      }
    }
  }
}
