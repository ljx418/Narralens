<mxfile host="app.diagrams.net" modified="2026-10-12T00:00:00.000Z" agent="Codex" version="24.7.17" pages="7">
  <diagram id="gap-overview" name="01_GAP总览">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="g-title" value="Narralens V1｜当前与目标 GAP" style="text;html=1;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;fontColor=#17202B;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="820" height="50" as="geometry"/></mxCell>
        <mxCell id="g-sub" value="事实基线：当前只有 PRD、架构、原型与契约示例；未发现生产源码，任何真实能力均不得标记为已实现。" style="text;html=1;fontSize=14;fontColor=#596879;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="g-now-head" value="当前状态｜设计已落盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#4C84C6;fontColor=#173B66;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="390" height="58" as="geometry"/></mxCell>
        <mxCell id="g-gap-head" value="必须闭环的 GAP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontColor=#6E4A00;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="605" y="130" width="390" height="58" as="geometry"/></mxCell>
        <mxCell id="g-target-head" value="V1 目标｜真实可验收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF5EA;strokeColor=#31966A;fontColor=#174F39;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="130" width="390" height="58" as="geometry"/></mxCell>
        <mxCell id="g-now" value="① prototype-v1 三阶段交互原型&lt;br&gt;② PRD / UX / 架构 / 验收文档&lt;br&gt;③ D1 真实 Hypit 双构建与 Studio 写回&lt;br&gt;④ OpenMontage 探针与 Proposal 边界&lt;br&gt;&lt;br&gt;&lt;b&gt;状态：Gate D1 已通过；业务代码未开发&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F6EE;strokeColor=#2E9D6E;fontColor=#243447;fontSize=15;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="390" height="310" as="geometry"/></mxCell>
        <mxCell id="g-gap" value="D1｜固定 OpenMontage / Hypit SHA、许可与真实命令&lt;br&gt;&lt;br&gt;D1｜30 秒工程：预览→导出→重开→改一镜→再导出&lt;br&gt;&lt;br&gt;D2–D5｜Host、Actor、Adapter、事务、锁、恢复、真实 Proposal&lt;br&gt;&lt;br&gt;D6–D7｜真实 3–5 分钟章节、20+ 镜头、3 处完整采用链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#D99B18;fontColor=#533C10;fontSize=15;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="605" y="220" width="390" height="310" as="geometry"/></mxCell>
        <mxCell id="g-target" value="NarralensApp 三阶段统一工作台&lt;br&gt;&lt;br&gt;LocalHost + ProjectWriteActor 串行事务&lt;br&gt;&lt;br&gt;OpenMontage 只产提案；Hypit Source + Run 是唯一影片事实源&lt;br&gt;&lt;br&gt;真实 MP4 / 字幕 / 来源许可 / 标题封面交付包&lt;br&gt;&lt;br&gt;&lt;b&gt;状态：规划中，须以真实证据出门&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBF8;strokeColor=#31966A;fontColor=#183F31;fontSize=15;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1150" y="220" width="390" height="310" as="geometry"/></mxCell>
        <mxCell id="g-arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D99B18;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="g-now" target="g-gap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#31966A;strokeWidth=3;endArrow=block;" edge="1" parent="1" source="g-gap" target="g-target"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-no-go" value="NO-GO：D1 任一真实链路失败｜上游接口靠猜测｜静态 UI 代替真实输出｜锁只作用于按钮｜存在第二时间轴｜许可或凭据边界不清" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8EA;strokeColor=#D84A59;fontColor=#7D1F29;fontSize=15;fontStyle=1;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="1480" height="84" as="geometry"/></mxCell>
        <mxCell id="g-legend" value="状态色：蓝＝设计已落盘　绿＝目标验收结果　黄＝待开发/待验证　红＝阻塞或拒绝出门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#CBD5DF;fontColor=#4C5968;fontSize=13;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="1000" height="52" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
