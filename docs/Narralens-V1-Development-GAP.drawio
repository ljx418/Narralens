  <diagram id="edit-transaction" name="04_编辑事务">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root><mxCell id="t0"/><mxCell id="t1" parent="t0"/>
        <mxCell id="t-title" value="编辑事务｜采用不是 UI 状态，而是可恢复的真实写入" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#17202B;" vertex="1" parent="t1"><mxGeometry x="40" y="25" width="1100" height="50" as="geometry"/></mxCell>
        <mxCell id="t-start" value="用户采用 Proposal&lt;br&gt;proposalId + baseRevision + selection + preserve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#4C84C6;fontSize=14;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="50" y="330" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="t-validate" value="1｜Validate&lt;br&gt;revision / 锁 / [start,end)&lt;br&gt;共享消费者 / 许可 / 预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="320" y="330" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="t-stage" value="2｜Prepare staging&lt;br&gt;复制工程到 staging&lt;br&gt;生成 typed operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="580" y="330" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="t-check" value="3｜Hypit check / compile&lt;br&gt;验证真实命令&lt;br&gt;帧数 / 音频引用 / 不变区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFECEF;strokeColor=#D84A59;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="840" y="330" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="t-commit" value="4｜Install + commit&lt;br&gt;安装文件后提交 metadata&lt;br&gt;revision 单调递增" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F6EE;strokeColor=#2E9D6E;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="1110" y="330" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="t-run" value="5｜Refresh real Run&lt;br&gt;真实预览 / build / MP4&lt;br&gt;返回 newRevision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF5EA;strokeColor=#31966A;fontSize=14;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="1370" y="330" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="t-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4C84C6;strokeWidth=3;endArrow=block;" edge="1" parent="t1" source="t-start" target="t-validate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D99B18;strokeWidth=3;endArrow=block;" edge="1" parent="t1" source="t-validate" target="t-stage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D99B18;strokeWidth=3;endArrow=block;" edge="1" parent="t1" source="t-stage" target="t-check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E9D6E;strokeWidth=3;endArrow=block;" edge="1" parent="t1" source="t-check" target="t-commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#31966A;strokeWidth=3;endArrow=block;" edge="1" parent="t1" source="t-commit" target="t-run"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-fail" value="任一步失败｜回滚 / 保留 Proposal / 主 Source 不变 / 保留上次成功输出&lt;br&gt;409 revision　422 缺素材/歧义　423 锁冲突　428 需审批　503 Runner 不可用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8EA;strokeColor=#D84A59;fontColor=#7D1F29;fontSize=15;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="320" y="570" width="1000" height="110" as="geometry"/></mxCell>
        <mxCell id="t-f1" value="失败" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D84A59;dashed=1;endArrow=block;" edge="1" parent="t1" source="t-validate" target="t-fail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-f2" value="失败" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D84A59;dashed=1;endArrow=block;" edge="1" parent="t1" source="t-check" target="t-fail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-f3" value="失败" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D84A59;dashed=1;endArrow=block;" edge="1" parent="t1" source="t-commit" target="t-fail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-journal" value="Journal：prepare → staging_validated → files_installed → metadata_committed；启动时先恢复未完成 journal。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EAFE;strokeColor=#7B4DDD;fontSize=14;align=left;spacing=14;" vertex="1" parent="t1"><mxGeometry x="320" y="735" width="1000" height="65" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="development-plan" name="05_开发计划">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root><mxCell id="p0"/><mxCell id="p1" parent="p0"/>
        <mxCell id="p-title" value="开发及验收计划｜先底座证据，再业务能力" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#17202B;" vertex="1" parent="p1"><mxGeometry x="40" y="25" width="1000" height="50" as="geometry"/></mxCell>
        <mxCell id="p-doc" value="DOC｜内外审已闭环&lt;br&gt;PRD / 架构 / 契约 / Gate 已冻结&lt;br&gt;待项目负责人批准实际开发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#4C84C6;fontSize=14;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="50" y="135" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="p-d1" value="D0–D1｜底座探测&lt;br&gt;上游 SHA / license / 命令&lt;br&gt;30 秒真实双导出 + Studio 写回&lt;br&gt;&lt;b&gt;Gate：已通过（限制已声明）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F6EE;strokeColor=#2E9D6E;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="320" y="135" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="p-d2" value="D2｜统一宿主与提案链&lt;br&gt;DirectorPane / Host API&lt;br&gt;真实 Runner → ProposalBundle&lt;br&gt;禁止手工复制 JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="590" y="135" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="p-d3" value="D3｜真实选区写入&lt;br&gt;stable identity / typed edit&lt;br&gt;locks / revision / rollback&lt;br&gt;409/422/423" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="860" y="135" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="p-d4" value="D4｜多提案与素材审批&lt;br&gt;3 个结构差异方案&lt;br&gt;materialize / 来源 / 费用&lt;br&gt;真实预览刷新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="1130" y="135" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="p-d5" value="D5｜复用与恢复&lt;br&gt;锁定旁白不重跑&lt;br&gt;字幕对齐 / 历史恢复&lt;br&gt;取消 / 晚到 / 外部修改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontSize=14;" vertex="1" parent="p1"><mxGeometry x="1400" y="135" width="160" height="130" as="geometry"/></mxCell>
        <mxCell id="p-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4C84C6;strokeWidth=3;endArrow=block;" edge="1" parent="p1" source="p-doc" target="p-d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D84A59;strokeWidth=3;endArrow=block;" edge="1" parent="p1" source="p-d1" target="p-d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D99B18;strokeWidth=3;endArrow=block;" edge="1" parent="p1" source="p-d2" target="p-d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D99B18;strokeWidth=3;endArrow=block;" edge="1" parent="p1" source="p-d3" target="p-d4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D99B18;strokeWidth=3;endArrow=block;" edge="1" parent="p1" source="p-d4" target="p-d5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-d67" value="D6–D7｜首周真实章节出门&lt;br&gt;10–15 分钟母项目，3–5 分钟精修切片，20+ 镜头&lt;br&gt;至少 3 个位置完成：定位 → 多方案 → 保留旁白采用 → 恢复 → 重开 → 再导出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF5EA;strokeColor=#31966A;fontSize=16;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="260" y="360" width="1080" height="120" as="geometry"/></mxCell>
        <mxCell id="p-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#31966A;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="p1" source="p-d5" target="p-d67"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p-w2" value="第 2 周｜100+ 镜头导航、空间备选生产化；跨镜能力仅在 D1 证明 stable ID 且契约测试通过后进入，否则转 V1.x；标题/封面真实生成、3 选题回归" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#6B7C90;fontSize=14;align=left;spacing=14;" vertex="1" parent="p1"><mxGeometry x="260" y="550" width="1080" height="80" as="geometry"/></mxCell>
        <mxCell id="p-w34" value="第 3–4 周｜完整 10–15 分钟闭环、StyleProfile、预算与队列、素材适配器、发布前检查、人工发布、反馈建议" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#6B7C90;fontSize=14;align=left;spacing=14;" vertex="1" parent="p1"><mxGeometry x="260" y="670" width="1080" height="80" as="geometry"/></mxCell>
        <mxCell id="p-rule" value="每个子阶段：先写验收标准 → 审计闭环 → 实现 → 自动化 + 真实数据 E2E → PRD 规格检视 → 证据落盘。重大偏差、虚假验收或真实链路阻塞立即停。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8EA;strokeColor=#D84A59;fontColor=#7D1F29;fontSize=14;fontStyle=1;align=left;spacing=14;" vertex="1" parent="p1"><mxGeometry x="260" y="795" width="1080" height="65" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="acceptance-gates" name="06_验收门限">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root><mxCell id="v0"/><mxCell id="v1" parent="v0"/>
        <mxCell id="v-title" value="验收门限｜用户场景、操作步骤、证据与拒绝条件" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#17202B;" vertex="1" parent="v1"><mxGeometry x="40" y="25" width="1100" height="50" as="geometry"/></mxCell>
        <mxCell id="v-p" value="Gate P｜原型出门｜已批准&lt;br&gt;操作：切换三阶段、模拟冲突、检查导出阻断&lt;br&gt;证据：prototype-v1 + Archify 9/9 + 浏览器交互&lt;br&gt;门限：规格、状态、路线、事实边界一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF5EA;strokeColor=#31966A;fontSize=14;align=left;spacing=14;" vertex="1" parent="v1"><mxGeometry x="70" y="140" width="330" height="190" as="geometry"/></mxCell>
        <mxCell id="v-doc" value="Gate DOC｜已通过&lt;br&gt;操作：PRD→实体→阶段→测试逐项追踪&lt;br&gt;证据：MD + 7 页 Draw.io + Archify + 内审/外审&lt;br&gt;门限：实际开发已获批准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F6EE;strokeColor=#2E9D6E;fontSize=14;align=left;spacing=14;" vertex="1" parent="v1"><mxGeometry x="450" y="140" width="330" height="190" as="geometry"/></mxCell>
        <mxCell id="v-d1" value="Gate D1｜已通过（限制已声明）&lt;br&gt;操作：30 秒双导出→重开→改单镜→Studio 写回/409&lt;br&gt;证据：日志、SHA、ffprobe、帧差、截图、安全扫描&lt;br&gt;限制：无字幕夹具；全 UI 手势待后续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F6EE;strokeColor=#2E9D6E;fontSize=14;align=left;spacing=14;" vertex="1" parent="v1"><mxGeometry x="830" y="140" width="330" height="190" as="geometry"/></mxCell>
        <mxCell id="v-v1" value="Gate V1｜实现出门&lt;br&gt;操作：真实章节定位→比较→保留旁白采用→锁→恢复→重开→再导出&lt;br&gt;证据：3–5 分钟、20+ 镜头、3 处采用链、失败路径与性能 trace&lt;br&gt;门限：PRD / 架构 / 实现 / 证据一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF5EA;strokeColor=#31966A;fontSize=14;align=left;spacing=14;" vertex="1" parent="v1"><mxGeometry x="1210" y="140" width="330" height="190" as="geometry"/></mxCell>
        <mxCell id="v-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#31966A;strokeWidth=3;endArrow=block;" edge="1" parent="v1" source="v-p" target="v-doc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4C84C6;strokeWidth=3;endArrow=block;" edge="1" parent="v1" source="v-doc" target="v-d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D99B18;strokeWidth=3;endArrow=block;" edge="1" parent="v1" source="v-d1" target="v-v1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-auto" value="自动化 Gate&lt;br&gt;契约 / 单元 / 集成 / Playwright / ffprobe / 帧采样&lt;br&gt;409、422、423、428、503、写入失败均有可复现证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EAFE;strokeColor=#7B4DDD;fontSize=14;" vertex="1" parent="v1"><mxGeometry x="210" y="470" width="520" height="120" as="geometry"/></mxCell>
        <mxCell id="v-human" value="人工体验 Gate&lt;br&gt;零号用户按最小步骤完成核心场景&lt;br&gt;审查实际交互、真实预览、导出与重开，不只看测试报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F6FB;strokeColor=#1593B6;fontSize=14;" vertex="1" parent="v1"><mxGeometry x="870" y="470" width="520" height="120" as="geometry"/></mxCell>
        <mxCell id="v-no" value="拒绝出门：真实链路用 mock 冒充｜目标架构未达成｜承诺功能未实现｜阻塞测试未解决｜PRD 规格偏移｜Draw.io 与代码事实不一致｜缺少真实数据/截图/日志/产物路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8EA;strokeColor=#D84A59;fontColor=#7D1F29;fontSize=15;fontStyle=1;align=left;spacing=14;" vertex="1" parent="v1"><mxGeometry x="210" y="665" width="1180" height="95" as="geometry"/></mxCell>
        <mxCell id="v-result" value="只有自动化 Gate 与人工体验 Gate 同时通过，且文档/架构同步到实现状态，才可声明阶段完成。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#CBD5DF;fontSize=15;fontStyle=1;" vertex="1" parent="v1"><mxGeometry x="360" y="805" width="880" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="milestones-risks" name="07_里程碑与风险">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root><mxCell id="m0"/><mxCell id="m1" parent="m0"/>
        <mxCell id="m-title" value="里程碑、状态与风险闭环" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#17202B;" vertex="1" parent="m1"><mxGeometry x="40" y="25" width="800" height="50" as="geometry"/></mxCell>
        <mxCell id="m-doc" value="DOC&lt;br&gt;V1 体验与开发基线&lt;br&gt;&lt;b&gt;内外审闭环 / 待开发审批&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#4C84C6;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="70" y="150" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="m-m0" value="M0&lt;br&gt;30 秒真实工程链&lt;br&gt;&lt;b&gt;已通过 / 证据已落盘&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E5F6EE;strokeColor=#2E9D6E;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="360" y="150" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="m-m1" value="M1&lt;br&gt;同页真实提案链&lt;br&gt;&lt;b&gt;未开始&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="650" y="150" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="m-m2" value="M2&lt;br&gt;真实局部写入 / 锁 / revision&lt;br&gt;&lt;b&gt;未开始&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="940" y="150" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="m-m3" value="M3&lt;br&gt;3–5 分钟章节出门&lt;br&gt;&lt;b&gt;未开始&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1250" y="150" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="m-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4C84C6;strokeWidth=3;endArrow=block;" edge="1" parent="m1" source="m-doc" target="m-m0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D84A59;strokeWidth=3;endArrow=block;" edge="1" parent="m1" source="m-m0" target="m-m1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D99B18;strokeWidth=3;endArrow=block;" edge="1" parent="m1" source="m-m1" target="m-m2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D99B18;strokeWidth=3;endArrow=block;" edge="1" parent="m1" source="m-m2" target="m-m3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m-r1" value="R1｜上游事实未知（已消减）&lt;br&gt;Hypit 0.3.1 与 OpenMontage 固定 SHA 已实测。&lt;br&gt;&lt;b&gt;剩余：真实 Provider / 母项目性能后续验证。Owner：技术负责人&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F6EE;strokeColor=#2E9D6E;fontSize=14;align=left;spacing=14;" vertex="1" parent="m1"><mxGeometry x="100" y="390" width="430" height="130" as="geometry"/></mxCell>
        <mxCell id="m-r2" value="R2｜第二时间轴（高）&lt;br&gt;UI/DB 若保存最终结构会造成双事实源。&lt;br&gt;&lt;b&gt;消减：架构测试禁止；只存 selection/draft/mapping。Owner：架构负责人&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8EA;strokeColor=#D84A59;fontSize=14;align=left;spacing=14;" vertex="1" parent="m1"><mxGeometry x="585" y="390" width="430" height="130" as="geometry"/></mxCell>
        <mxCell id="m-r3" value="R3｜虚假验收（高）&lt;br&gt;静态页面或 mock 不能证明真实工程链。&lt;br&gt;&lt;b&gt;消减：双 MP4、重开、哈希、ffprobe、帧采样。Owner：验收负责人&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8EA;strokeColor=#D84A59;fontSize=14;align=left;spacing=14;" vertex="1" parent="m1"><mxGeometry x="1070" y="390" width="430" height="130" as="geometry"/></mxCell>
        <mxCell id="m-r4" value="R4｜身份映射与选区漂移（高）&lt;br&gt;数组下标或正则写 Source 会改错镜头。&lt;br&gt;&lt;b&gt;消减：stable ID、[start,end)、不变区字段对比。Owner：Hypit Adapter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontSize=14;align=left;spacing=14;" vertex="1" parent="m1"><mxGeometry x="100" y="590" width="430" height="130" as="geometry"/></mxCell>
        <mxCell id="m-r5" value="R5｜素材许可/外传/费用（中高）&lt;br&gt;事实引用不等于素材再利用许可。&lt;br&gt;&lt;b&gt;消减：AssetRef、428 审批、交付许可清单。Owner：内容负责人&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontSize=14;align=left;spacing=14;" vertex="1" parent="m1"><mxGeometry x="585" y="590" width="430" height="130" as="geometry"/></mxCell>
        <mxCell id="m-r6" value="R6｜长视频性能（中）&lt;br&gt;60–180 镜头可能阻塞输入与滚动。&lt;br&gt;&lt;b&gt;消减：120 镜头夹具、虚拟化、p95≤100ms、trace。Owner：前端负责人&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D99B18;fontSize=14;align=left;spacing=14;" vertex="1" parent="m1"><mxGeometry x="1070" y="590" width="430" height="130" as="geometry"/></mxCell>
        <mxCell id="m-next" value="下一出门条件：先制定并审计 D2 开发/验收计划；实现 NarralensApp / DirectorPane / Host API 的最小真实 Proposal 路径，不得用手工 JSON 冒充 Runner。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#4C84C6;fontSize=15;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="300" y="790" width="1000" height="65" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
