        <mxCell id="db" value="既有工程事实保持&#10;【已有实体·本轮未复验】 project_state、project_transaction、active_commit、snapshot、journal、outbox。pointer实际在active_commit；每项目单引擎。新表由MAIN在同连接迁移。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e3f0e7;strokeColor=#5b8067;fontColor=#20313c;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="635" y="440" width="520" height="195" />
        </mxCell>
        <mxCell id="resource" value="driver / resource / provider三类边界&#10;【待新增】 DriverSession限制编排权；worker lease限制执行；ResourceClaim分IO/CPU/RAM/GPU；provider未知结果先对账。失联不贸然卸载/重提。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4edfa;strokeColor=#54739e;fontColor=#20313c;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1215" y="440" width="520" height="195" />
        </mxCell>
        <mxCell id="recovery" value="恢复序列与故障矩阵&#10;【已有·需修改】 保留现有：import/legacy→OpenFilm装配→history/adoption/history→通用Coordinator→migration→materialize→outbox。新建/外部受理/prepare/发布/DB前后/native未确认/进程退出逐边界测试；0或+1，无分叉。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d4;strokeColor=#aa7a29;fontColor=#20313c;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="740" width="1055" height="210" />
        </mxCell>
        <mxCell id="cancel" value="取消与回退&#10;【风险与阻塞】 准备取消后晚到不采用；prepared后按journal收敛。内容回退仅restore新revision；关UI不删工程。未知费用/结果保留，不凭猜测记0。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8e4e1;strokeColor=#a76258;fontColor=#20313c;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1170" y="740" width="565" height="210" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
