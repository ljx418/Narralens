  <diagram id="v1-r4-page-7" name="07 用户场景 验收门限与出门">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1290" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="07 用户场景 验收门限与出门" style="text;html=0;align=left;verticalAlign=middle;fontSize=25;fontColor=#20313c;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="22" width="1700" height="35" />
        </mxCell>
        <mxCell id="scope" value="文档设计；R4体验已批准；产品NOT_RUN；生产NOT_RELEASED；“已有”仅源码接缝" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#20313c;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="67" width="1700" height="35" />
        </mxCell>
        <mxCell id="ux01" value="R4-UX-01 原工作台与唯一选择/时钟&#10;【待验证/未开放】 新面板开关前后可播放/精剪；selection、草稿、版本不重置" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efe7f6;strokeColor=#86689c;fontColor=#20313c;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="145" width="1060" height="70" />
        </mxCell>
        <mxCell id="ux02" value="R4-UX-02 完整改单镜决策链&#10;【待验证/未开放】 目标→候选→差异→核对→确认→同步→继续；不手填内部ID" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efe7f6;strokeColor=#86689c;fontColor=#20313c;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="221" width="1060" height="70" />
        </mxCell>
        <mxCell id="ux03" value="R4-UX-03 真实当前与候选比较&#10;【待验证/未开放】 所选proposal/preview/版本匹配；比较revision+0；最终3–6案均可选" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efe7f6;strokeColor=#86689c;fontColor=#20313c;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="297" width="1060" height="70" />
        </mxCell>
        <mxCell id="ux04" value="R4-UX-04 可信确认与最终重验&#10;【待验证/未开放】 base/锁/许可/impact/approval负向+0；成功恰好+1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efe7f6;strokeColor=#86689c;fontColor=#20313c;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="373" width="1060" height="70" />
        </mxCell>
        <mxCell id="ux05" value="R4-UX-05 提交与native确认分开&#10;【待验证/未开放】 延迟native ack时显示待同步，不能填Host值作成功" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efe7f6;strokeColor=#86689c;fontColor=#20313c;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="449" width="1060" height="70" />
        </mxCell>
        <mxCell id="ux06" value="R4-UX-06 局部返工与取消晚到&#10;【待验证/未开放】 仅相关范围重算；保留旁白/时长；晚到不自动采用" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efe7f6;strokeColor=#86689c;fontColor=#20313c;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="525" width="1060" height="70" />
        </mxCell>
        <mxCell id="ux07" value="R4-UX-07 顶部横向工作流&#10;【待验证/未开放】 折叠仍有当前事项；展开定位当前步；真实事件p95≤2秒" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efe7f6;strokeColor=#86689c;fontColor=#20313c;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="601" width="1060" height="70" />
        </mxCell>
        <mxCell id="ux08" value="R4-UX-08 非模态系统控制&#10;【待验证/未开放】 无遮罩/焦点锁、不遮导演栏；打开仍可编辑，关闭仅收起" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efe7f6;strokeColor=#86689c;fontColor=#20313c;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="677" width="1060" height="70" />
        </mxCell>
        <mxCell id="ux09" value="R4-UX-09 真实模型与资源状态&#10;【待验证/未开放】 请求/加载/预热/就绪分开；活动/未知任务不越权卸载" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efe7f6;strokeColor=#86689c;fontColor=#20313c;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="753" width="1060" height="70" />
        </mxCell>
        <mxCell id="ux10" value="R4-UX-10 阻塞/断线/过期/未知&#10;【待验证/未开放】 保存草稿、重核原任务；检查不变成重提/重复扣费" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efe7f6;strokeColor=#86689c;fontColor=#20313c;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="829" width="1060" height="70" />
        </mxCell>
        <mxCell id="ux11" value="R4-UX-11 布局与可访问&#10;【待验证/未开放】 1440×900/1366×768；390审阅模式；方向键/焦点/播报" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efe7f6;strokeColor=#86689c;fontColor=#20313c;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="905" width="1060" height="70" />
        </mxCell>
        <mxCell id="ux12" value="R4-UX-12 真实人验与交付&#10;【待验证/未开放】 实际改单镜、重开、snapshot绑定双导出与完整decode；用户签署" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#efe7f6;strokeColor=#86689c;fontColor=#20313c;fontSize=13;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
