{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:narralens:s0-r2:observation",
  "description": "Read-only target proposal. Server Observation and UI-local EditorView remain separate. Not registered in production.",
  "$defs": {
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "shot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "maxItems": 128
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preserve": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "narration",
              "duration"
            ]
          },
          "maxItems": 128
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "project_id",
        "shot_ids",
        "base_revision",
        "preserve",
        "range"
      ]
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "maxLength": 1000
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "waiting_resource",
            "waiting_user",
            "succeeded",
            "failed",
            "cancel_requested",
            "cancelled",
            "stale"
          ]
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "progress_percent": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "maxItems": 128
        },
        "input_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 128
        },
        "output_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 128
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "maxItems": 128
        }
      },
      "required": [
        "node_id",
        "label",
        "state",
        "job_id",
        "attempt",
        "progress_percent",
        "reason",
        "dependencies",
        "input_refs",
        "output_refs",
        "next_actions"
      ]
    },
    "Log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "host",
            "worker",
            "agent_public_unverified"
          ]
        },
        "level": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "transaction_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event_id",
        "project_id",
        "at",
        "source",
        "level",
        "summary",
        "job_id",
        "transaction_id"
      ]
    },
    "Commit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "revision",
        "snapshot_id",
        "transaction_id"
      ]
    },
    "EditorView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "string",
          "enum": [
            "native_bridge",
            "unknown"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "project_id",
        "revision",
        "snapshot_id",
        "evidence",
        "observed_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence": {
                "const": "native_bridge"
              }
            },
            "required": [
              "evidence"
            ]
          },
          "then": {
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "snapshot_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              }
            }
          },
          "else": {
            "properties": {
              "revision": {
                "type": "null"
              },
              "snapshot_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "observation.v1-preview"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "maxItems": 128
        },
        "last_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "logs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Log"
          },
          "maxItems": 128
        },
        "has_more_logs": {
          "type": "boolean"
        },
        "next_log_cursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "sampled_at": {
          "type": "string",
          "format": "date-time"
        },
        "goal": {
          "type": "string",
          "maxLength": 1000
        },
        "agent_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_event_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "view_scope_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "health": {
          "$ref": "#/$defs/HealthRead"
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "maxItems": 128
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "scope",
        "steps",
        "last_commit",
        "logs",
        "has_more_logs",
        "next_log_cursor",
        "cursor",
        "sampled_at",
        "goal",
        "agent_identity",
        "snapshot_event_id",
        "instance_id",
        "generation",
        "view_scope_id",
        "health",
        "next_actions"
      ]
    },
    "Range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_frame_exclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fps_num": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fps_den": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "start_frame",
        "end_frame_exclusive",
        "fps_num",
        "fps_den"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "brief",
            "script",
            "storyboard",
            "asset",
            "materialization",
            "snapshot",
            "delivery"
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "version"
      ]
    },
    "AgentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "principal_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "declared_client_name": {
          "type": "string",
          "maxLength": 1000
        },
        "identity_source": {
          "const": "authenticated_host_session"
        }
      },
      "required": [
        "principal_id",
        "declared_client_name",
        "identity_source"
      ]
    },
    "HealthMetric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "percent",
            "bytes",
            "count"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "os",
            "worker",
            "unavailable"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "observed_at"
      ]
    },
    "ServiceHealth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "starting",
            "ready",
            "degraded",
            "stopped",
            "unknown"
          ]
        },
        "ownership": {
          "type": "string",
          "enum": [
            "owned",
            "shared"
          ]
        },
        "sampled_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthMetric"
          },
          "maxItems": 16
        }
      },
      "required": [
        "service_id",
        "state",
        "ownership",
        "sampled_at",
        "expires_at",
        "reason",
        "metrics"
      ]
    },
    "HealthRead": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServiceHealth"
          },
          "maxItems": 32
        },
        "sample_interval_ms": {
          "const": 5000
        },
        "stale_after_ms": {
          "const": 15000
        }
      },
      "required": [
        "services",
        "sample_interval_ms",
        "stale_after_ms"
      ]
    }
  }
}
