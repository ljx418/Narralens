{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/schemas/restore-request.schema.json",
  "description": "Body of POST /api/migration/v1/projects/:id/history/restore. Restoring old content always produces a new snapshot and revision; the target snapshot id is a content reference, never a pointer to re-activate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "base_revision",
    "expected_source_digest",
    "control_revision",
    "target_snapshot_id",
    "impact_id",
    "impact_hash",
    "approval",
    "idempotency_key"
  ],
  "properties": {
    "format": { "const": "narralens.restore-request@1.0" },
    "base_revision": { "type": "integer", "minimum": 0 },
    "expected_source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "control_revision": { "type": "integer", "minimum": 0 },
    "target_snapshot_id": { "type": "string", "minLength": 1 },
    "impact_id": { "type": "string", "minLength": 1 },
    "impact_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed"],
      "properties": { "confirmed": { "const": true } }
    },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}
