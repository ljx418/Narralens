{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/schemas/adopt-request.schema.json",
  "description": "Body of POST /api/migration/v1/projects/:id/edits for an adoption. approval.confirmed is only meaningful on a valid, unexpired, hash-matching impact; it never authorizes cost or egress.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "base_revision",
    "expected_source_digest",
    "control_revision",
    "materialization_id",
    "impact_id",
    "impact_hash",
    "approval",
    "idempotency_key"
  ],
  "properties": {
    "format": { "const": "narralens.adopt-request@1.0" },
    "base_revision": { "type": "integer", "minimum": 0 },
    "expected_source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "control_revision": { "type": "integer", "minimum": 0 },
    "materialization_id": { "type": "string", "minLength": 1 },
    "impact_id": { "type": "string", "minLength": 1 },
    "impact_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed"],
      "properties": { "confirmed": { "const": true } }
    },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}
