{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/schemas/proposal-request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["base_revision", "selection", "intent", "preserve"],
  "properties": {
    "base_revision": { "type": "integer", "minimum": 0 },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["shot_id", "start_frame", "end_frame_exclusive"],
      "properties": {
        "shot_id": { "type": "string", "minLength": 1 },
        "start_frame": { "type": "integer", "minimum": 0 },
        "end_frame_exclusive": { "type": "integer", "minimum": 1 }
      }
    },
    "intent": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "preserve": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
