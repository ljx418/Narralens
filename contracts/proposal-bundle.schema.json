{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/schemas/proposal-bundle.schema.json",
  "title": "Narralens ProposalBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "project_id", "proposal_id", "base_revision",
    "selection", "preserve", "summary", "segments", "assets_needed",
    "source_refs", "cost", "requires_materialization", "renderable"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "narralens.proposal_bundle" },
    "project_id": { "type": "string", "minLength": 1 },
    "proposal_id": { "type": "string", "minLength": 1 },
    "base_revision": { "type": "integer", "minimum": 0 },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "start_frame", "end_frame_exclusive"],
      "properties": {
        "shot_id": { "type": "string", "minLength": 1 },
        "start_frame": { "type": "integer", "minimum": 0 },
        "end_frame_exclusive": { "type": "integer", "minimum": 1 }
      }
    },
    "preserve": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": { "type": "string", "minLength": 1 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "duration_frames", "intent", "asset_id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "asset_id": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "assets_needed": { "type": "array", "items": { "type": "object" } },
    "source_refs": { "type": "array", "items": { "type": "object" } },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "currency", "amount"],
      "properties": {
        "status": { "enum": ["unknown", "estimated", "approved", "spent"] },
        "currency": { "type": ["string", "null"], "minLength": 3, "maxLength": 3 },
        "amount": { "type": ["number", "null"], "minimum": 0 },
        "approved_ceiling": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "source_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "sha256"],
      "properties": {
        "kind": { "const": "openmontage.proposal_packet" },
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "requires_materialization": { "type": "boolean" },
    "renderable": { "type": "boolean" }
  }
}
