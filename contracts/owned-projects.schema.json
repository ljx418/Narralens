{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/schemas/owned-projects.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "projects",
    "next_after"
  ],
  "properties": {
    "format": {
      "const": "narralens.owned-projects@1.0"
    },
    "next_after": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        }
      ]
    },
    "projects": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "title",
          "project_revision",
          "snapshot_id",
          "saved_at",
          "frame_count",
          "state"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "project_revision": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ]
          },
          "snapshot_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          },
          "saved_at": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "frame_count": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "state": {
            "enum": [
              "saved",
              "attention"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "saved"
                }
              }
            },
            "then": {
              "properties": {
                "project_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "snapshot_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "saved_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "frame_count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
