{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/schemas/materialize-request.schema.json",
  "description": "Body of POST /api/migration/v1/projects/:id/proposals/:proposalId/materialize. Carries no path, URL, shell argument or client-asserted rights/hash fact: every input is an id the Host re-reads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "comparison_id",
    "base_revision",
    "expected_source_digest",
    "control_revision",
    "profile",
    "segment_bindings",
    "idempotency_key"
  ],
  "properties": {
    "format": { "const": "narralens.materialize-request@1.0" },
    "comparison_id": { "type": "string", "minLength": 1 },
    "base_revision": { "type": "integer", "minimum": 0 },
    "expected_source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "control_revision": { "type": "integer", "minimum": 0 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id"],
      "properties": { "profile_id": { "const": "wave2-proxy-720p30-v1" } }
    },
    "segment_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "asset_id", "source_start_frame", "source_end_frame_exclusive"],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "asset_id": { "type": "string", "minLength": 1 },
          "source_start_frame": { "type": "integer", "minimum": 0 },
          "source_end_frame_exclusive": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}
