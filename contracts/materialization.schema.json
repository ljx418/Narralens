{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/schemas/materialization.schema.json",
  "description": "The read-only preparation record M3 produces. It is a discardable recomputable fact: nothing in it is content authority, and the proxy token is resolved by the Host alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "materialization_id",
    "job_id",
    "project_id",
    "comparison_id",
    "proposal_id",
    "state",
    "base_revision",
    "source_digest",
    "control_revision",
    "proposal_sha256",
    "asset_inventory_sha256",
    "rights_digest",
    "request_digest",
    "native_plan",
    "proxy",
    "lineage",
    "blocking_reasons",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "format": { "const": "narralens.materialization@1.0" },
    "materialization_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "comparison_id": { "type": "string", "minLength": 1 },
    "proposal_id": { "type": "string", "minLength": 1 },
    "state": {
      "enum": [
        "queued",
        "running",
        "validating",
        "ready_for_adoption",
        "stale",
        "cancel_requested",
        "cancelled",
        "failed",
        "attention"
      ]
    },
    "base_revision": { "type": "integer", "minimum": 0 },
    "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "control_revision": { "type": "integer", "minimum": 0 },
    "proposal_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "asset_inventory_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rights_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "request_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "native_plan": {
      "anyOf": [{ "$ref": "#/$defs/native_plan" }, { "type": "null" }]
    },
    "proxy": {
      "anyOf": [{ "$ref": "#/$defs/proxy" }, { "type": "null" }]
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/lineage_entry" }
    },
    "blocking_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "frame_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame_exclusive"],
      "properties": {
        "start_frame": { "type": "integer", "minimum": 0 },
        "end_frame_exclusive": { "type": "integer", "minimum": 1 }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "sha256", "frame_count", "profile_id"],
      "properties": {
        "token": {
          "description": "Content-addressed relative token resolved by the Host; never an absolute server path.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "maxLength": 200,
          "not": { "pattern": "(^|/)\\.\\.(/|$)|://" }
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "frame_count": { "type": "integer", "minimum": 1 },
        "profile_id": { "type": "string", "minLength": 1 }
      }
    },
    "native_clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clip_id",
        "segment_id",
        "asset_id",
        "asset_sha256",
        "timeline",
        "source",
        "track_id"
      ],
      "properties": {
        "clip_id": { "type": "string", "minLength": 1 },
        "segment_id": { "type": "string", "minLength": 1 },
        "asset_id": { "type": "string", "minLength": 1 },
        "asset_sha256": { "$ref": "#/$defs/sha256" },
        "timeline": { "$ref": "#/$defs/frame_range" },
        "source": { "$ref": "#/$defs/frame_range" },
        "track_id": { "type": "string", "minLength": 1 }
      }
    },
    "native_plan": {
      "description": "A single flattened clip is not a native plan; C-01 forbids passing one off as three editable shots.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "engine",
        "fps",
        "clips",
        "narration_policy",
        "duration_policy",
        "total_frames",
        "plan_sha256"
      ],
      "properties": {
        "format": { "const": "narralens.native-plan@1.0" },
        "engine": { "const": "openfilm" },
        "fps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["num", "den"],
          "properties": { "num": { "const": 30 }, "den": { "const": 1 } }
        },
        "clips": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/native_clip" }
        },
        "narration_policy": { "const": "preserve" },
        "duration_policy": { "const": "preserve" },
        "total_frames": { "type": "integer", "minimum": 1 },
        "plan_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "lineage_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_sha256", "input_asset_id", "input_sha256", "source", "output"],
      "properties": {
        "output_sha256": { "$ref": "#/$defs/sha256" },
        "input_asset_id": { "type": "string", "minLength": 1 },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "source": { "$ref": "#/$defs/frame_range" },
        "output": { "$ref": "#/$defs/frame_range" }
      }
    }
  }
}
