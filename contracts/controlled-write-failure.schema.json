{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/schemas/controlled-write-failure.schema.json",
  "description": "Terminal, idempotently replayable failure of a controlled write. Transient recovery-pending responses are not stored in this shape.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "transaction_id", "project_id", "operation", "previous_revision", "new_revision", "source_digest", "status", "error"],
  "properties": {
    "format": { "const": "narralens.controlled-write-failure@1.0" },
    "transaction_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "operation": { "const": "adopt_materialization" },
    "previous_revision": { "type": "integer", "minimum": 0 },
    "new_revision": { "type": "integer", "minimum": 0 },
    "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "const": "aborted" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http_status", "code", "message"],
      "properties": {
        "http_status": { "enum": [409, 422, 423, 428, 500] },
        "code": { "$ref": "api-error.schema.json#/$defs/apiErrorCode" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "details": {}
      }
    }
  }
}
