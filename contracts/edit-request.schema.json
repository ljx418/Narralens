{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narralens.local/schemas/edit-request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["base_revision", "idempotency_key", "selection", "preserve", "operations"],
  "properties": {
    "base_revision": { "type": "integer", "minimum": 0 },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["shot_id", "start_frame", "end_frame_exclusive"],
      "properties": {
        "shot_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "start_frame": { "type": "integer", "minimum": 0 },
        "end_frame_exclusive": { "type": "integer", "minimum": 1 }
      }
    },
    "preserve": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "allOf": [{ "contains": { "const": "narration" } }, { "contains": { "const": "duration" } }],
      "items": { "enum": ["narration", "duration"] }
    },
    "operations": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "edit-operation.schema.json" } }
  }
}
