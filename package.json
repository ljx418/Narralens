{
  "name": "narralens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "check": "tsc --noEmit && vitest run --config vitest.config.ts && python3 -I tests/wave2/m4a/impact-hash.golden.py tests/wave2/m4a/impact-hash.vectors.json && vite build",
    "build": "vite build",
    "start": "tsx src/host/start.ts",
    "recover": "tsx src/host/recover.ts",
    "evidence:d421-large": "tsx tests/evidence/d421-large-upload-evidence.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:contracts": "vitest run --config vitest.config.ts tests/contracts",
    "test:m2.1": "vitest run --config vitest.config.ts tests/m2.1 tests/architecture",
    "test:wave2:w2.0": "vitest run --config vitest.config.ts tests/wave2/w2-asset-02-production.test.ts tests/wave2/w2-asset-03-atomic.test.ts tests/wave2/w2-asset-inventory-port.test.ts tests/wave2/w2-asset-ledger.test.ts tests/wave2/w2-contracts.test.ts tests/wave2/w2-host-composition.test.ts tests/wave2/w2-host-diagnostics.test.ts tests/wave2/w2-job-kind-fresh.test.ts tests/wave2/w2-job-kind-migration.test.ts tests/wave2/w2-ledger-attention.test.ts tests/wave2/w2-openfilm-composition.test.ts tests/wave2/w2-project-resolver.test.ts tests/wave2/w2-route-fitness.test.ts tests/wave2/w2-typed-edit.test.ts",
    "test:wave2:m3": "vitest run --config vitest.config.ts tests/wave2/m3",
    "test:wave2:m4a": "vitest run --config vitest.config.ts tests/wave2/m4a",
    "test:wave2:m4b": "vitest run --config vitest.config.ts tests/wave2/m4b",
    "test:wave2:m4c": "vitest run --config vitest.config.ts tests/wave2/m4c",
    "test:wave2:m4c:vectors": "tsx tests/wave2/m4c/generate-restore-plan-vectors.ts",
    "test:wave2:m4c:golden-python": "python3 -I tests/wave2/m4c/restore-plan.golden.py tests/wave2/m4c/restore-plan.vectors.json",
    "test:wave2:m4a:vectors": "tsx tests/wave2/m4a/generate-vectors.ts",
    "test:wave2:m4a:golden-python": "python3 -I tests/wave2/m4a/impact-hash.golden.py tests/wave2/m4a/impact-hash.vectors.json",
    "evidence:wave2:m3": "bash tools/wave2-m3-run-evidence.sh",
    "evidence:wave2:m3:integrity": "node tools/wave2-m3-evidence-integrity.mjs",
    "evidence:wave2:m4a": "bash tools/wave2-m4a-run-evidence.sh",
    "evidence:wave2:m4a:manifest": "node tools/wave2-m4a-evidence-manifest.mjs",
    "evidence:wave2:m4a:integrity": "node tools/wave2-m4a-evidence-integrity.mjs",
    "evidence:wave2:m4a:historical": "node tools/wave2-m4a-evidence-historical.mjs",
    "evidence:wave2:m4b": "bash tools/wave2-m4b-run-evidence.sh",
    "evidence:wave2:m4b:manifest": "node tools/wave2-m4b-evidence-manifest.mjs",
    "evidence:wave2:m4b:integrity": "node tools/wave2-m4b-evidence-integrity.mjs",
    "evidence:wave2:m4b:historical": "node tools/wave2-m4b-evidence-historical.mjs",
    "evidence:wave2:m4c": "bash tools/wave2-m4c-run-evidence.sh",
    "evidence:wave2:m4c:manifest": "node tools/wave2-m4c-evidence-manifest.mjs",
    "evidence:wave2:m4c:integrity": "node tools/wave2-m4c-evidence-integrity.mjs",
    "test:wave2:fitness": "vitest run --config vitest.config.ts tests/architecture tests/wave2/*fitness*",
    "check:m2.1-docs": "node tools/m2.1-doc-consistency.mjs",
    "test:m2.1:golden-vectors": "tsx tests/m2.1-golden/generate-vectors.ts",
    "test:m2.1:golden-python": "python3 -I tests/m2.1-golden/source-digest-v1.golden.py tests/m2.1-golden/source-digest-v1.vectors.json",
    "evidence:m2.1:secret-scan": "tsx tools/secret-scan.ts",
    "evidence:m2.1": "bash tools/m2.1-run-evidence.sh",
    "evidence:m2.1:manifest": "tsx tools/m2.1-evidence-manifest.ts",
    "evidence:m2.1:integrity": "node tools/m2.1-evidence-integrity.mjs",
    "evidence:m2.1:repro": "tsx tools/m2.1-external-review-repro.mts",
    "evidence:m2.1:finalize": "bash tools/m2.1-finalize-evidence.sh",
    "evidence:m2.2:manifest": "tsx tools/m2.2-evidence-manifest.ts",
    "evidence:m2.2:integrity": "node tools/m2.2-evidence-integrity.mjs",
    "evidence:wave1": "bash tools/wave1-run-evidence.sh",
    "evidence:wave1:manifest": "tsx tools/wave1-evidence-manifest.ts",
    "evidence:wave1:integrity": "node tools/wave1-evidence-integrity.mjs",
    "evidence:wave1:historical": "node tools/wave1-evidence-historical.mjs"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "busboy": "1.6.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/busboy": "1.5.5",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "axe-core": "4.10.3",
    "happy-dom": "18.0.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
