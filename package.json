{
  "name": "narralens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "check": "tsc --noEmit && vitest run --config vitest.config.ts && vite build",
